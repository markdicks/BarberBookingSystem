# Local development uses data/bookings.sqlite and logs OTP codes to the terminal.
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
BUSINESS_WHATSAPP_NUMBER=
BUSINESS_ADDRESS=1 Braam Street, Alberton, GP, 1449, South Africa
SCHEDULE_JSON={"1":["08:00","20:00"],"2":["08:00","20:00"],"3":["08:00","20:00"],"4":["08:00","20:00"],"5":["08:00","17:30"],"6":["08:00","14:30"]}

